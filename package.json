{
  "name": "bill-payment-automation",
  "version": "1.0.0",
  "description": "Hybrid manual and automated testing framework for bill payment APIs and UI",
  "scripts": {
    "note:01": "===== GENERAL TEST EXECUTION =====",
    "test": "playwright test",
    "test:repeat": "playwright test --repeat-each=2",
    "test:api": "playwright test auth/api users/api protocol/api",
    "note:02": "===== AUTHENTICATION API TESTS =====",
    "test:auth": "playwright test auth/api",
    "test:auth:me": "playwright test auth/api/get-user.spec.ts",
    "test:auth:client": "playwright test auth/api/oauth-client.spec.ts",
    "test:auth:password": "playwright test auth/api/oauth-password.spec.ts",
    "test:auth:refresh": "playwright test auth/api/oauth-refresh.spec.ts",
    "test:auth:validation": "playwright test auth/api/oauth-validation.spec.ts",
    "note:03": "===== USERS API TESTS =====",
    "test:user": "playwright test users/api",
    "test:user:create": "playwright test users/api/create-user.spec.ts",
    "test:user:delete": "playwright test users/api/delete-user.spec.ts",
    "test:user:list": "playwright test users/api/get-users.spec.ts",
    "test:user:getById": "playwright test users/api/get-userById.spec.ts",
    "test:user:patch": "playwright test users/api/patch-user.spec.ts",
    "test:user:update": "playwright test users/api/update-user.spec.ts",
    "note:04": "===== OTHER API MODULES =====",
    "test:billers": "playwright test billers",
    "test:bills": "playwright test bills",
    "test:payments": "playwright test payments",
    "test:e2e": "playwright test e2e",
    "note:05": "===== TEST EXECUTION BY TAG =====",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:security": "playwright test --grep @security",
    "test:validation": "playwright test --grep @validation",
    "note:06": "===== DEBUG AND HEADED MODE =====",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "note:07": "===== PLAYWRIGHT HTML REPORT =====",
    "report:html": "playwright show-report automation-testing/playwright-report",
    "note:08": "===== ALLURE REPORT =====",
    "report:allure": "allure serve automation-testing/allure-results",
    "report:allure:generate": "allure generate automation-testing/allure-results --clean -o automation-testing/allure-report",
    "report:allure:open": "allure open automation-testing/allure-report",
    "report:allure:build": "npm run report:allure:generate && npm run report:allure:open",
    "report:allure:clean": "rimraf automation-testing/allure-report",
    "report:allure:results:clean": "rimraf automation-testing/allure-results",
    "report:allure:clean:all": "rimraf automation-testing/allure-results automation-testing/allure-report",
    "note:09": "===== CLEANUP =====",
    "clean:allure": "npm run report:allure:clean:all",
    "clean:reports": "rimraf automation-testing/allure-results automation-testing/allure-report automation-testing/playwright-report automation-testing/test-results",
    "note:10": "===== AUTOMATIC ALLURE CLEANUP BEFORE TESTS =====",
    "pretest": "npm run clean:allure",
    "pretest:repeat": "npm run clean:allure",
    "pretest:api": "npm run clean:allure",
    "pretest:auth": "npm run clean:allure",
    "pretest:auth:me": "npm run clean:allure",
    "pretest:auth:client": "npm run clean:allure",
    "pretest:auth:password": "npm run clean:allure",
    "pretest:auth:refresh": "npm run clean:allure",
    "pretest:auth:validation": "npm run clean:allure",
    "pretest:user": "npm run clean:allure",
    "pretest:user:create": "npm run clean:allure",
    "pretest:user:delete": "npm run clean:allure",
    "pretest:user:list": "npm run clean:allure",
    "pretest:user:getById": "npm run clean:allure",
    "pretest:user:patch": "npm run clean:allure",
    "pretest:user:update": "npm run clean:allure",
    "pretest:protocol": "npm run clean:allure",
    "pretest:billers": "npm run clean:allure",
    "pretest:bills": "npm run clean:allure",
    "pretest:payments": "npm run clean:allure",
    "pretest:e2e": "npm run clean:allure",
    "pretest:jobs": "npm run clean:allure",
    "pretest:smoke": "npm run clean:allure",
    "pretest:regression": "npm run clean:allure",
    "pretest:security": "npm run clean:allure",
    "pretest:validation": "npm run clean:allure",
    "note:11": "===== TYPESCRIPT VALIDATION =====",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "api-testing",
    "ui-testing",
    "manual-testing"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.13.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^17.4.2",
    "zod": "^4.6.5"
  }
}